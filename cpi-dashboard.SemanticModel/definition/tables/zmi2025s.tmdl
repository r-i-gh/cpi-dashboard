table zmi2025s
	lineageTag: 1d7fbac9-e0ec-44dd-bff5-fe45e42fda6b

	measure 指数（値） =
			
			IF(
			    HASONEVALUE(zmi2025s[系列]),
			    AVERAGE(zmi2025s[指数])
			)
		formatString: 0.0
		lineageTag: 2e1ae126-32a5-46b1-a7c1-12c28d56479e

	measure 前年同月比 =
			
			VAR CurrentIndex = [指数（値）]
			VAR PrevIndex =
			    CALCULATE([指数（値）], SAMEPERIODLASTYEAR('日付'[日付]))
			RETURN
			IF(
			    NOT ISBLANK(CurrentIndex) && NOT ISBLANK(PrevIndex),
			    DIVIDE(CurrentIndex, PrevIndex) - 1
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f2ac6f3f-3000-4c2a-85c7-b8f4c0d895d6

	measure 最新月 =
			
			CALCULATE(MAX(zmi2025s[年月]), REMOVEFILTERS('日付'))
		formatString: General Date
		lineageTag: d6a3b1c6-505b-41cb-beb6-80176478d82d

	measure 最新月ラベル = FORMAT([最新月], "yyyy年M月")
		lineageTag: e29d469f-a0b5-41ac-b96b-e75cc2e3293b

	measure 前年同月比（最新月） =
			
			VAR LatestDate = [最新月]
			RETURN
			CALCULATE(
			    [前年同月比],
			    DATESBETWEEN('日付'[日付], LatestDate, EOMONTH(LatestDate, 0))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3331b55c-35cb-4358-a523-920430bdd223

	measure 寄与度 =
			
			VAR W = SELECTEDVALUE('系列マスタ'[ウエイト])
			VAR CurIdx = [指数（値）]
			VAR PrevIdx = CALCULATE([指数（値）], SAMEPERIODLASTYEAR('日付'[日付]))
			VAR PrevTotal =
			    CALCULATE(
			        [指数（値）],
			        SAMEPERIODLASTYEAR('日付'[日付]),
			        REMOVEFILTERS('系列マスタ'),
			        '系列マスタ'[系列] = "総合"
			    )
			RETURN
			IF(
			    NOT ISBLANK(CurIdx) && NOT ISBLANK(PrevIdx) && NOT ISBLANK(W),
			    DIVIDE((CurIdx - PrevIdx) * W / 10000, PrevTotal)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d8f4ba29-4645-4842-bec6-95fc25911c0b

	measure 寄与度（最新月） =
			
			VAR LatestDate = [最新月]
			RETURN
			CALCULATE(
			    [寄与度],
			    DATESBETWEEN('日付'[日付], LatestDate, EOMONTH(LatestDate, 0))
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bf7ec796-6749-46a8-8122-1f202c7d1988

	measure 寄与度合計（10大費目・最新月） =
			
			SUMX(
			    FILTER(ALL('系列マスタ'), '系列マスタ'[区分] = "10大費目"),
			    [寄与度（最新月）]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0056b9ba-0e63-46df-81a9-10131f7d8afb

	measure 寄与度（最新月・表示用） =
			
			SUMX(
			    VALUES('系列マスタ'[系列]),
			    [寄与度（最新月）]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2b0af809-ddd0-488a-a7c7-ca170443ab12

	measure 寄与度（表示用） =
			
			SUMX(
			    VALUES('系列マスタ'[系列]),
			    [寄与度]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0a9cc71b-2a62-4f78-9396-8a1c044650ea

