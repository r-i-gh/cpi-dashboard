		annotation SummarizationSetBy = Automatic

	column 系列
		dataType: string
		lineageTag: f0a0614f-4cdf-4c7d-a43e-b21d38b2eccb
		summarizeBy: none
		sourceColumn: 系列

		annotation SummarizationSetBy = Automatic

	column 指数
